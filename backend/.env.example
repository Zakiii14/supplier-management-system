# Application
NODE_ENV=development
PORT=3000

# Public demo mode. Leave false for development and real production installations.
# When true, sensitive account/configuration mutations are blocked server-side.
DEMO_MODE=false

# Demo reset safeguards. Keep disabled outside the dedicated shared demo database.
DEMO_RESET_ENABLED=false
DEMO_DATABASE_NAME=
# Intentionally shared public password for demo_* accounts. Minimum 8 characters.
DEMO_ACCOUNT_PASSWORD=

# Set true only when the API runs behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Runtime observability and lifecycle
# Supported levels: debug, info, warn, error, silent.
LOG_LEVEL=info
# Maximum time allowed for the database readiness check.
READINESS_TIMEOUT_MS=3000
# Maximum time allowed for graceful shutdown before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional origins.
CORS_ORIGINS=

# PostgreSQL
# Use DATABASE_URL for managed databases, or leave it empty and use DB_* below.
# If DATABASE_URL contains sslmode/sslcert/sslkey/sslrootcert, leave DB_SSL_MODE empty.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplier_management
DB_USER=postgres
DB_PASSWORD=your_database_password

# Local default: disable. Production defaults to require when no SSL mode is supplied.
# Supported explicit values: disable, require, verify-full.
# Use verify-full when your provider certificate chain can be verified.
DB_SSL_MODE=disable
# Optional PEM CA certificate. Multiline values may use escaped \n characters.
DB_SSL_CA=

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h

# Email
# Local development can use console. Production must use resend.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=

# Private file storage
# Development can leave this empty to use backend/storage.
# Production requires an absolute path backed by a durable mounted volume.
# SupplyFlow creates payment-proofs/, user-avatars/, and supplier-invoices/ below it.
FILE_STORAGE_ROOT=

# Backup & recovery
# Production requires an absolute path separate from FILE_STORAGE_ROOT.
# Use a second durable volume/location and replicate completed bundles off-host.
BACKUP_ROOT=
BACKUP_RETENTION_DAYS=14
# Optional PostgreSQL client binary overrides when pg_dump/pg_restore are not on PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# Legacy development/test overrides. Ignored by server startup when FILE_STORAGE_ROOT is set.
PAYMENT_PROOF_STORAGE_DIR=
USER_AVATAR_STORAGE_DIR=
SUPPLIER_INVOICE_STORAGE_DIR=
