# Application
NODE_ENV=development
PORT=3000
# node for a traditional Node host, vercel for Vercel Functions/Fluid compute.
DEPLOYMENT_TARGET=node

# Public demo mode. Leave false for development and real production installations.
# When true, sensitive account/configuration mutations are blocked server-side.
DEMO_MODE=false

# Demo reset safeguards. Keep disabled outside the dedicated shared demo database.
DEMO_RESET_ENABLED=false
DEMO_DATABASE_NAME=
# Intentionally shared public password for demo_* accounts. Minimum 8 characters.
DEMO_ACCOUNT_PASSWORD=
# Shared demo sessions are considered stale after this many minutes without activity.
DEMO_IDLE_MINUTES=15

# Set true only when the API runs behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Runtime observability and lifecycle
# Supported levels: debug, info, warn, error, silent.
LOG_LEVEL=info
READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional origins.
CORS_ORIGINS=

# PostgreSQL
# For Neon/Vercel, use the pooled Neon URL as DATABASE_URL.
DATABASE_URL=
# Optional direct/unpooled URL for operator jobs such as migrations and demo reset.
DATABASE_URL_UNPOOLED=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplier_management
DB_USER=postgres
DB_PASSWORD=your_database_password

# Keep the HTTP pool small for serverless deployments.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# Local default: disable. Production defaults to require when no SSL mode is supplied.
# If DATABASE_URL already contains sslmode, leave DB_SSL_MODE empty.
DB_SSL_MODE=disable
DB_SSL_CA=

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h

# Email
# Local development can use console. Production must use resend.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=

# Private file storage
# filesystem keeps the existing local/traditional-host behavior.
# vercel-blob is required when DEPLOYMENT_TARGET=vercel.
FILE_STORAGE_PROVIDER=filesystem
# Only used by filesystem storage. Production filesystem deployments require an absolute durable path.
FILE_STORAGE_ROOT=
# Blob object keys are stored below <prefix>/<namespace>/<uuid filename>.
BLOB_PATH_PREFIX=supplyflow
# Vercel deployments can authenticate Blob through project OIDC.
# External runners such as GitHub Actions need a read/write token.
BLOB_READ_WRITE_TOKEN=

# Backup & recovery
# Required for production filesystem deployments and must be separate from FILE_STORAGE_ROOT.
# Blob-backed live demo deployments use deterministic demo reset; Blob backup/restore is not run by the HTTP app.
BACKUP_ROOT=
BACKUP_RETENTION_DAYS=14
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# Legacy development/test overrides. Ignored when FILE_STORAGE_ROOT is set.
PAYMENT_PROOF_STORAGE_DIR=
USER_AVATAR_STORAGE_DIR=
SUPPLIER_INVOICE_STORAGE_DIR=
