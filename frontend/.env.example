# Recommended production strategy: serve the frontend and API behind the same public origin,
# and reverse-proxy /api to the backend. The existing Vite dev proxy also uses /api.
VITE_API_BASE_URL=/api

# Public demo login surface. Keep false for normal installations.
VITE_DEMO_MODE=false
# Public demo credential used only for the intentionally shared demo accounts.
# Vite exposes VITE_* values to the browser, so never place private secrets here.
VITE_DEMO_PASSWORD=

# If the API is deployed on a separate origin instead, use an absolute URL, for example:
# VITE_API_BASE_URL=https://api.example.com/api
